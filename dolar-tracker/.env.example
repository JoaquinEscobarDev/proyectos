# Fuente de datos: mindicador.cl (Banco Central de Chile) — no requiere API key

# URL del frontend (para CORS)
FRONTEND_URL=https://proyectos.fun

# Token secreto para proteger POST /api/actualizar
# Genera uno con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
UPDATE_TOKEN=cambia_esto_por_un_token_seguro

# Notificaciones push (VAPID) — genera con: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=admin@tudominio.cl

# Umbral de cambio en CLP para disparar notificación push (default: 3)
UMBRAL_CAMBIO=3

PORT=3000
